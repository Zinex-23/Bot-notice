# ==============================================================================
# DailyFlow - Environment Variables
# ==============================================================================

# PostgreSQL Database (Neon or Vercel Postgres)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/dailyflow?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/dailyflow?sslmode=require"

# Application URL (deployed Vercel URL or http://localhost:3000)
APP_BASE_URL="http://localhost:3000"

# Telegram Bot
# Create a bot via @BotFather on Telegram to get your bot token
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_WEBHOOK_SECRET="random_webhook_secret_string"

# Cron Job Secret
# Used by cron-job.org or Vercel Cron to trigger dispatch and daily prep endpoints
CRON_SECRET="your_secure_cron_secret_here"

# Authentication
# Secret key used for signing session tokens (generate with: openssl rand -base64 32)
AUTH_SECRET="your_random_auth_secret_key_minimum_32_characters_long"

# Admin Access PIN (default: 123456)
# Used for single-user secure dashboard login
ADMIN_PIN="123456"

# Timezone (Default: Asia/Ho_Chi_Minh)
NEXT_PUBLIC_TIMEZONE="Asia/Ho_Chi_Minh"
